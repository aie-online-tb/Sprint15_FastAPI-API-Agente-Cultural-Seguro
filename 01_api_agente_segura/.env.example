# Gemini (agente)
GEMINI_API_KEY=

# Acceso a la API (query ?api_key=). Copiar a .env y no subir .env al repo.
API_KEY=cambia-esta-clave

# Máximo de peticiones por clave en 60 s (bajar el valor para practicar 429)
RATE_LIMIT_PER_MINUTE=30

# Forzamos un rate limit de 5 peticiones por minuto para simular el bloqueo de la API.
# RATE_LIMIT_PER_MINUTE=5

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:3000

# Segundos máximos por turno (POST /ask y /approve).
# Ajustar según lo que tarda Gemini en nuestra red:
# tras un /ask OK, mirar en consola duration_ms y dejar margen (p. ej. 2× ese tiempo).
# Si el valor es bajo, casi todos los /ask acabarán en 504.

# Timeout por defecto (ajustar a vuestra red)
ASK_TIMEOUT_SECONDS=300

# Forzamos un timeout de 15 segundos para que el agente no se quede bloqueado
# ASK_TIMEOUT_SECONDS=15
